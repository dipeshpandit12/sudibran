# Copy to .env and fill in what you have. Everything is optional: anything left empty runs in a
# clearly labelled simulated mode, and /api/health lists what's real and what isn't.

# ── Claude (Anthropic) ── parser key; planner key is only for the optional PLANNER=claude mode.
ANTHROPIC_API_KEY_PARSER=
ANTHROPIC_API_KEY_PLANNER=
PARSER_MODEL=claude-opus-5-5
PLANNER_MODEL=claude-opus-5-5

# ── Planner: scripted (offline) | claude | droid ──
# droid = Factory Droid via the Python SDK. Log in once with `droid`; its subscription supplies the model.
# Use a non-custom model id returned by droid_sdk.list_models(). No Anthropic planner key is passed to Droid.
PLANNER=scripted
DROID_MODEL=claude-opus-5-5

# ── Capital One Nessie (sandbox bank) ── then run: uv run python scripts/nessie_seed.py
NESSIE_API_KEY=

# ── CRS Credit API (CalHacks sandbox, test identities only) ── account at https://calhacks.crscreditapi.com
# Check with: uv run python scripts/crs_probe.py
CRS_BASE_URL=https://api-sandbox.stitchcredit.com:443/api
CRS_USERNAME=
CRS_PASSWORD=

# ── How /api/inject behaves: live (real pipeline) | scripted (prototype keyword match) ──
INJECT_MODE=live

# ── Secrets between our own services (compose). Generate: uv run python scripts/make_secrets.py ──
INTERNAL_TOKEN=
BROKER_TOKEN=
PARSER_TOKEN=
SUDIBRAN_SIGNING_KEY=
SELLER_AGENT_SECRET=acme-seller-demo-secret

# ── Policy engine: local (in-process mirror of policy/sudibran.rego) | opa ──
POLICY_ENGINE=local
OPA_URL=http://localhost:8181

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
